#1. Conditional Probability
#English
#Conditional probability means:

#What is the probability of A given that we already know B happened?

#Notation:

#P(A∣B)
#Read it as:

#Probability of A given B.



p_spam = 0.10
p_give_spam = 0.60
p_give_not_spam = 0.05

p_not_spam = 1 - p_spam

p_free = (
    p_give_spam * p_spam
+ p_give_not_spam * p_not_spam)

p_spam_free = (
    p_give_spam * p_spam
) / p_free
print(p_spam_free)
print(f"{p_spam_free:.2%}")


p_fraud = 0.02
p_warning_fraud = 0.80
p_warning_not_fraud = 0.10

p_not_fraud = 1 - p_fraud
p_warning = ( p_fraud * p_not_fraud + 
             p_warning_fraud * p_warning_not_fraud

)

p_fraud_warning = (p_fraud * p_warning_fraud) / p_warning

print(p_fraud_warning)
print(f"{p_fraud_warning:.2%}")




























